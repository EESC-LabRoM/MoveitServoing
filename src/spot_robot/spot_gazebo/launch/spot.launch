<?xml version="1.0"?>
<launch>

  <arg name="paused" default="true" doc="Iniciar o Gazebo pausado"/>
  <arg name="gui" default="true" doc="Iniciar Gazebo com interface gráfica"/>

  <!-- Iniciar Gazebo com o mundo customizado -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find spot_gazebo)/worlds/custom_world.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Publicar URDF do Spot no servidor de parâmetros -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find spot_moveit_config)/config/spot.urdf.xacro"/>
  <param name="robot_description_semantic" command="$(find xacro)/xacro --inorder $(find spot_moveit_config)/config/spot.srdf"/>
  <param name="use_sim_time" value="true"/>

  <!-- Iniciar Gazebo ROS Control -->
  <node name="gazebo_ros_control" pkg="gazebo_ros_control" type="gazebo_ros_control"
        respawn="false" output="screen"/>

  <!-- Spawn do modelo no Gazebo -->
  <node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model spot_robot -x 0 -y 0 -z 0.7"
        respawn="false" output="screen"/>

  <!-- Carregar utilitários do controlador -->
  <include file="$(find spot_gazebo)/launch/controller_utils.launch"/>

  <!-- Carregar os controladores -->
  <rosparam file="$(find spot_gazebo)/controller/spot_controller.yaml" command="load"/>

  <!-- Iniciar os controladores -->
  <node name="controller_spawner" pkg="controller_manager" type="controller_manager"
        args="spawn spot_arm_controller spot_gripper_controller"
        respawn="false" output="screen"/>
        
</launch>
