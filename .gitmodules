[submodule "realsense-ros"]
	path = realsense-ros
	url = https://github.com/IntelRealSense/realsense-ros.git
[submodule "src/realsense-ros"]
	path = src/realsense-ros
	url = https://github.com/IntelRealSense/realsense-ros.git
[submodule "src/ddynamic_reconfigure"]
	path = src/ddynamic_reconfigure
	url = https://github.com/pal-robotics/ddynamic_reconfigure.git
[submodule "src/moveit"]
	path = src/moveit
	url = https://github.com/ros-planning/moveit.git
	branch = noetic-devel
[submodule "src/zed-ros-wrapper"]
	path = src/zed-ros-wrapper
	url = https://github.com/stereolabs/zed-ros-wrapper.git
	branch = master
[submodule "src/zed-ros-interfaces"]
	path = src/zed-ros-interfaces
	url = https://github.com/stereolabs/zed-ros-interfaces.git
	branch = main
